---
interface Props { logCount: number; productCount: number }
const { logCount, productCount } = Astro.props;
---
<nav aria-label="Sections" style="border-bottom: 1px solid #30363d">
  <div class="wrap" style="display: flex; flex-wrap: wrap; gap: 4px">
    <a class="tab tab-active" href="#top" aria-current="page"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M2 2.5h4.5a1.5 1.5 0 011.5 1.5v9.5a1 1 0 00-1-1H2z"></path><path d="M14 2.5H9.5A1.5 1.5 0 008 4v9.5a1 1 0 011-1h5z"></path></svg>Overview</a>
    <a class="tab" href="#log"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="8" cy="8" r="2.5"></circle><path d="M1 8h4.5M10.5 8H15"></path></svg>Log <span class="cnt">{logCount}</span></a>
    <a class="tab" href="#products"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><path d="M8 1.5l6 3v7l-6 3-6-3v-7z"></path><path d="M2 4.5l6 3 6-3M8 7.5v7"></path></svg>Products <span class="cnt">{productCount}</span></a>
    <a class="tab" href="#revenue"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M1.5 14.5h13M3.5 11v3.5M7 7v7.5M10.5 9v5.5M14 4v10.5"></path></svg>Revenue</a>
  </div>
</nav>
